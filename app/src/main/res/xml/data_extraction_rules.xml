<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : ni sauvegarde cloud, ni transfert d'appareil à appareil.
     La base est chiffrée avec une clé Android Keystore qui ne quitte pas l'appareil :
     une copie transférée serait illisible. Le changement de téléphone passe par
     l'export chiffré manuel de l'application. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
